            m = input("Rejimni tanlang: ").strip()
            if m == "1": os.system("vibe-mode code")
            elif m == "2": os.system("vibe-mode game")
            elif m == "3": os.system("vibe-mode eco")
            input("\nDavom etish uchun [Enter] bosing...")
        elif tanlov == "2":
            print("\n[1] Claude Code\n[2] Aider\n[3] Gemini\n[4] Mahalliy Ollama")
            a = input("Agentni tanlang: ").strip()
            if a == "1": os.system("vibe agent claude")
            elif a == "2": os.system("vibe agent aider")
            elif a == "3": os.system("vibe agent gemini")
            elif a == "4": os.system("vibe agent local")
            input("\nDavom etish uchun [Enter] bosing...")
