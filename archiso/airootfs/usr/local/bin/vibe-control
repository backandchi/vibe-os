        print("  [3] 🛡️ Vibe Shield (Tizim Himoyasi & Xavfsiz Sandbox)")
        print("  [4] ⏳ Vibe Ghost Git (Time Machine - Vaqt Bo'ylab Sayohat)")
        print("  [5] 📱 Android (Waydroid) & Steam & Windows EXE Boshqaruvi")
        print("  [6] 🌐 Vibe Tunnel (Localhost loyihani telefonga ulash)")
        print("  [7] 🧘 Vibe Flow (Zen Mode + Lo-Fi Audio)")
        print("  [8] 🧹 Vibe Clean (Diskdagi kesh va node_modules tozalash)")
