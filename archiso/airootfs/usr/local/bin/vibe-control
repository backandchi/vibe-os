    print("\033[2J\033[H", end="")

def print_header():
    print("\033[1;36m")
    print("  ██╗   ██╗██╗██████╗ ███████╗ ██████╗ ███████╗")
    print("  ██║   ██║██║██╔══██╗██╔════╝██╔═══██╗██╔════╝")
    print("  ██║   ██║██║██████╔╝█████╗  ██║   ██║███████╗")
    print("  ╚██╗ ██╔╝██║██╔══██╗██╔══╝  ██║   ██║╚════██║")
    print("   ╚████╔╝ ██║██████╔╝███████╗╚██████╔╝███████║")
    print("    ╚═══╝  ╚═╝╚═════╝ ╚══════╝ ╚═════╝ ╚══════╝\033[0m")
    print("  \033[1;35m⚡ VIBEOS CONTROL CENTER (Yagona Boshqaruv Markazi) ⚡\033[0m")
    print("  \033[1;33m👑 Muallif / Creator: backandchi | 🇺🇿 O'zbekiston\033[0m")
    print("="*60)

def main_menu():
    while True:
        clear_screen()
        print_header()
        
        # Real vaqt xotira holati
        try:
            mem_output = subprocess.check_output("free -h", shell=True).decode()
            lines = mem_output.splitlines()
            print(f"\033[1;32m📊 {lines[0]}\033[0m")
            print(f"   {lines[1]}")
            if len(lines) > 2:
                print(f"   {lines[2]} (ZRAM Siqilgan xotira)")
        except Exception:
            pass
        print("="*60)
        
        print("\033[1;37mASOSIY BOSHQARUV BO'LIMLARI:\033[0m")
        print("  [1] ⚡ Ish Rejimini O'zgartirish (Code / Game / Eco Mode)")
