#!/bin/bash
# VibeOS AI Yordamchisi va Scratchpad Launcher
# Muallif / Creator: backandchi

clear
cat /etc/vibe-logo.ascii 2>/dev/null
echo ""
echo "=========================================================="
echo "      🤖 VibeOS AI Yordamchisi (Muallif: backandchi)     "
echo "=========================================================="
echo ""

if systemctl is-active --quiet ollama || systemctl --user is-active --quiet ollama; then
    echo "✔ Ollama sun'iy intellekt xizmati faol ishlamoqda."
    echo "Kod yozish uchun eng yaxshi modellar: qwen2.5-coder, deepseek-coder"
    echo ""
    read -p "Qaysi model bilan ishlamoqchisiz? [standart: qwen2.5-coder]: " model
    model=${model:-qwen2.5-coder}
    echo "'$model' modeli bilan suhbat boshlanmoqda..."
    ollama run "$model"
else
    echo "💡 Mahalliy Ollama xizmati hozircha o'chiq."
    echo "Uni yoqish uchun quyidagi buyruqni bering:"
    echo "   systemctl --user start ollama"
    echo ""
    echo "Yoki onlayn API kalitlar (Claude / Gemini / ChatGPT) orqali ishlang."
    echo "To'liq qo'llanmani ko'rish uchun terminalda 'vibe-wiki' deb yozing."
    echo ""
    read -p "Dasturdan chiqish uchun [Enter] tugmasini bosing..."
fi
